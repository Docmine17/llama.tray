[Desktop Entry]
Version=1.0
Type=Application
Name=Llama Tray
GenericName=Llama Server Manager
Comment=Tray manager for llama-server (llama.cpp)
# When packaged, the executable should be placed in /usr/bin/ or accessible via $PATH
Exec=llama-tray
# The packager should place the SVG in /usr/share/icons/hicolor/scalable/apps/
Icon=llama-tray-icon
Terminal=false
Categories=Utility;Development;System;
Keywords=llama;ai;tray;ggml;server;
StartupNotify=true
StartupWMClass=llama-tray